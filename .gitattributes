# Godot text sources: keep LF so UIDs, imports and scenes diff identically on every machine.
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.uid       text eol=lf
*.gdshader  text eol=lf
*.json      text eol=lf
*.ps1       text eol=crlf

# Small derived binaries stay in ordinary Git until size or churn justifies LFS.
*.png  binary
*.jpg  binary
*.webp binary
*.svg  text eol=lf
*.ogg  binary
*.ttf  binary
*.otf  binary

# Selective Git LFS: layered art masters and raw audio/video masters only (TDS §8).
*.kra      filter=lfs diff=lfs merge=lfs -text
*.ora      filter=lfs diff=lfs merge=lfs -text
*.psd      filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase      filter=lfs diff=lfs merge=lfs -text
*.wav      filter=lfs diff=lfs merge=lfs -text
*.flac     filter=lfs diff=lfs merge=lfs -text
*.mp4      filter=lfs diff=lfs merge=lfs -text
*.webm     filter=lfs diff=lfs merge=lfs -text
*.mov      filter=lfs diff=lfs merge=lfs -text
